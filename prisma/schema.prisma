// Prisma schema — will be migrated to Neon once DATABASE_URL is provisioned.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────
// Email + password accounts (Auth.js Credentials provider, JWT sessions).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  // Physiology profile (women's mode). Nullable so existing accounts are
  // unaffected until they fill it in.
  sex                      String?  // "male" | "female"
  goal                     String?  // "fat_loss" | "recomp" | "muscle_gain" | "maintain"
  menstrualTrackingEnabled Boolean  @default(false)
  cycleStartDate           String?  // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyLogs    DailyLog[]
  meals        MealEntry[]
  workouts     WorkoutSession[]
  measurements Measurement[]
  sleep        SleepLog[]
  foods        FoodItem[]
  target       UserTarget?
}

// The user's current resolved daily target (today's gym/rest goal). Pushed by
// the client on load + whenever targets are edited, so the widget always shows
// the latest goal with no re-paste. One row per user.
model UserTarget {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kcal      Int
  protein   Int
  updatedAt DateTime @updatedAt
}

// Per-user data. Prod has no legacy server rows (DB was never provisioned),
// so userId is required and uniqueness is scoped per user from the start.
model DailyLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  gymDay    Boolean  @default(false)
  checklist Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model MealEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  mealType   String
  items      Json
  totals     Json
  createdAt  DateTime @default(now())

  @@index([userId, date])
}

model WorkoutSession {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  sessionType String
  totalVolume Float      @default(0)
  exercises   Exercise[]
  createdAt   DateTime   @default(now())

  @@index([userId, date])
}

model Exercise {
  id        String         @id @default(cuid())
  sessionId String
  name      String
  sets      Json
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Measurement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  weightKg    Float?
  waistCm     Float?
  hipCm       Float?
  shoulderCm  Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model SleepLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  bedtime     String   @default("")
  wakeTime    String   @default("")
  durationMin Int      @default(0)
  quality     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityId   String?
  entityType String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([actor, createdAt])
}

// ─── Food-composition catalogue ───────────────────────────────────────────
// Shared, read-only reference library (all sources, not per-user). Nutrient
// values are per 100 g edible portion. Empty CSV cells are stored as NULL —
// NEVER 0 — so "unknown" and "genuinely zero" stay distinguishable.
enum FoodSource {
  TKPI
  CUSTOM
  USDA
}

model Food {
  id             String     @id @default(cuid())
  // e.g. "TKPI:DP031", "CUSTOM:CF001", "USDA:US12345"
  sourceCode     String     @unique
  source         FoodSource
  name           String
  // lowercased + diacritics stripped, for search
  nameNormalized String
  state          String?
  foodGroup      String?
  // Optional cuisine / "genre" tag (padang, chinese, japanese, …) for grouping
  // the food search. Mostly set by JSON import; null falls back to a name-based
  // classifier client-side.
  cuisine        String?

  // 21 nutrient columns, per 100 g edible portion. Decimal (not float) to
  // preserve the source precision; NULL means "not measured / unknown".
  water_g            Decimal?
  energy_kcal        Decimal?
  protein_g          Decimal?
  fat_g              Decimal?
  carb_g             Decimal?
  fiber_g            Decimal?
  ash_g              Decimal?
  calcium_mg         Decimal?
  phosphorus_mg      Decimal?
  iron_mg            Decimal?
  sodium_mg          Decimal?
  potassium_mg       Decimal?
  copper_mg          Decimal?
  zinc_mg            Decimal?
  retinol_mcg        Decimal?
  beta_carotene_mcg  Decimal?
  carotene_total_mcg Decimal?
  thiamin_mg         Decimal?
  riboflavin_mg      Decimal?
  niacin_mg          Decimal?
  vitc_mg            Decimal?

  // Edible-portion percentage (Bagian Dapat Dimakan). Defaults to 100.
  bddPct         Int       @default(100)
  // Custom foods only: cooked weight of one conventional portion.
  portionGCooked Decimal?
  note           String?
  // English name, when the source carries one (R2FIT library, drinks, café).
  // Used for bilingual search + display; null for TKPI/dessert rows.
  nameEn         String?

  // ─── Persisted search index (computed at seed time; see scripts/foodRanking) ─
  // Recall bag: normalized name + English name + serving desc + group, so a
  // query matches on more than the Indonesian name alone. Empty = not yet
  // backfilled (the seed treats "" as a signal to re-index).
  searchText String @default("")
  // Static popularity prior — staples & high-confidence entries rank first.
  popularity Int    @default(0)

  servings FoodServing[]

  @@index([nameNormalized])
  @@index([foodGroup])
  @@index([popularity])
}

// Household-measure serving sizes for a Food. These are editable conventions
// (NOT sourced from the composition CSV) — see SERVING_CONVENTIONS in the seed.
model FoodServing {
  id     String  @id @default(cuid())
  foodId String
  food   Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  label  String
  grams  Decimal

  @@index([foodId])
}

// Food library — rows with `userId = null` are the shared base catalogue
// (built-ins + Hermes-discovered) visible to everyone; rows with a `userId`
// are that user's private custom foods.
model FoodItem {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  per100g   Json
  source    String   @default("richie-web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([userId])
}
