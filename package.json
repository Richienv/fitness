{
  "name": "richie-recomp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-server-imports.mjs && npx tsx scripts/validate-pack.ts data/*.csv && prisma generate && (prisma db push --skip-generate || echo 'db push skipped \u2014 run npm run db:push manually') && (npx tsx scripts/seed-foods.ts || echo 'food seed skipped') && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test lib/*.test.ts lib/suggest/*.test.ts",
    "test:foods": "node --experimental-strip-types --test scripts/seed-foods.test.ts",
    "seed:foods": "tsx scripts/seed-foods.ts",
    "validate:foods": "tsx scripts/validate-pack.ts data/*.csv",
    "check:server-imports": "node scripts/check-server-imports.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  }
}
